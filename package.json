{
  "name": "cloudflare-dns-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready single-admin DNSHE/DNSNEKO management console for Cloudflare Pages + D1.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-06-10",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc -b --pretty",
    "d1:init:local": "wrangler d1 execute dns_manager --local --file=d1/schema.sql",
    "d1:init:remote": "wrangler d1 execute dns_manager --remote --file=d1/schema.sql",
    "secret:password": "node scripts/hash-password.mjs",
    "secret:key": "node scripts/generate-secret.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.19.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
