# SPA fallback for client-side routes. Each entry serves the root document
# (200 rewrite) so deep links survive a hard refresh. Static assets under
# /assets/* are never rewritten, and Pages Functions handle /api/* first.
/login      /  200
/accounts   /  200
/groups     /  200
/settings   /  200
/logs       /  200
/backup     /  200
/domains    /  200
/domains/*  /  200
