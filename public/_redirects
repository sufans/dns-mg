# SPA fallback: serve index.html for client-side routes so deep links such as
# /domains or /domains/1/abc work on a hard refresh or direct visit.
/login      /index.html  200
/domains    /index.html  200
/domains/*  /index.html  200
/accounts   /index.html  200
/settings   /index.html  200
/logs       /index.html  200
/backup     /index.html  200
